# Hanajian local development. Never commit real keys or tokens.
# VITE_* values are read by electron-vite; prefer the application's secure settings.
VITE_DB_KEY=
VITE_AUTO_LOGIN=false
VITE_FILTER_MSG_TYPES=
VITE_IMAGE_XOR_KEY=
VITE_IMAGE_AES_KEY=

# Main-process/bootstrap/script options must be set in the launching process,
# not assigned here: .env is not a process.env loader for these options.
# HANAJIAN_USER_DATA: optional isolated profile, e.g. E:/temp/hanajian-profile
# HANAJIAN_DISABLE_GPU=1: optional GPU workaround
# HANAJIAN_RESOURCES_PATH: optional native resource override
# HANAJIAN_GO_EXE: optional Go executable for the independent connector
# HANAJIAN_DEBUG_IMAGE=1: opt-in image diagnostics
# HANAJIAN_UPDATE_SIMULATION=true: development-only updater simulation
# HANAJIAN_UPDATE_SIMULATION_DURATION_MS=8000
# WXE_E2E_CLOSE_DELAY_MS=0: E2E process option; existing WXE_* options remain supported.
# HANAJIAN_API_TOKEN belongs to the external Agent environment, not this app's .env.

# Experimental self-hosted share-card setup script reads these from .env.
WECHAT_SHARE_DOMAIN=share.example.com
WECHAT_SHARE_APP_ID=
WECHAT_SHARE_APP_SECRET=
WECHAT_SHARE_UPLOAD_TOKEN=
